# Local demo only. Never place production credentials in this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Use a disposable local PostgreSQL database only.
DATABASE_URL=postgresql://demo_user:replace_me@127.0.0.1:5432/vice_interviewer_demo

# Replace locally. These placeholders are not usable credentials.
JWT_SECRET=replace_with_a_local_random_value
JWT_EXPIRES_IN=24h
SESSION_COOKIE_SECURE=false
ALLOW_MOCK_AUTH=true
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_or_hex_key

# Optional LLM. Leave API key empty to exercise rule-based fallbacks.
DEEPSEEK_BASE_URL=https://llm-gateway.example.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=example-chat-model
LLM_TIMEOUT_SEC=25

# Optional meeting integration. No real credentials are included.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/feishu/callback
FEISHU_LIVE_CAPTURE_ENABLED=false
LARK_CLI_PATH=/usr/local/bin/lark-cli
WORKER_HEALTH_PORT=3002

WORKSPACE_ROOT=./demo-workspace

